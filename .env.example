# PFIS (Patient Friction Intelligence System) Environment Configuration Template

# Server Environment & Port Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Security & Session Secrets (Replace with a strong secret in production)
JWT_SECRET=your_pfis_jwt_secret_key_here

# Operational Database Engine Selection
# Supported options: 'mongodb' | 'postgres' | 'mysql' | 'auto'
DATABASE_TYPE=auto

# MongoDB Configuration (Primary Operational Store for PFIS Data)
MONGODB_URI=mongodb://localhost:27017/pfis
MONGODB_DB_NAME=pfis

# Alternative Relational Database Connection (PostgreSQL / MySQL)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/pfis
# DATABASE_URL=mysql://root:password@localhost:3306/pfis

# ABDM (Ayushman Bharat Digital Mission) Integration Settings
# Operating Modes: 'sandbox' | 'demo' | 'production'
ABDM_MODE=sandbox

# Official ABDM Gateway Base URL (Official Sandbox or Production Gateway)
ABDM_BASE_URL=https://dev.abdm.gov.in/api/v1

# ABDM API Client Credentials (Server-Side Only — NEVER expose to frontend)
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_REDIRECT_URI=http://localhost:5000/api/integrations/abdm/callback

# ABDM Subsystem Feature Toggles
ABDM_HFR_ENABLED=false
ABDM_HPR_ENABLED=false
ABDM_ABHA_ENABLED=false
ABDM_HEALTH_RECORDS_ENABLED=false

# Multi-Source Data Architecture Mode ('demo' | 'sandbox' | 'production')
DATA_MODE=demo

# Optional External Mapping Integrations
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
