# PFIS (Patient Friction Intelligence System) Environment Configuration Template

# Server Environment & Port Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Security & Session Secrets (Replace with a strong secret in production)
JWT_SECRET=your_pfis_jwt_secret_key_here

# Operational Database Engine Selection
# Supported options: 'mongodb' | 'postgres' | 'mysql' | 'auto'
DATABASE_TYPE=auto

# MongoDB Configuration (Primary Operational Store for PFIS Data)
MONGODB_URI=mongodb://localhost:27017/pfis
MONGODB_DB_NAME=pfis

# OpenAI Realtime Voice AI Engine Configuration (Server-Side Only)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_VOICE=alloy

# Real Telephony & Toll-Free Number Configuration
# NOTE: Provisioned via authorized cloud telephony provider (Twilio/Exotel/Plivo)
PFIS_TOLL_FREE_NUMBER=
TELEPHONY_PROVIDER=demo
TELEPHONY_ACCOUNT_ID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_API_KEY=
TELEPHONY_API_SECRET=
VOICE_MODE=demo
VOICE_RECORDING_ENABLED=false
VOICE_TRANSCRIPT_ENABLED=false
VOICE_RETENTION_DAYS=30

# Teleconsultation Realtime Video Configuration
VIDEO_PROVIDER=webrtc_native
VIDEO_API_KEY=
VIDEO_API_SECRET=

# ABDM (Ayushman Bharat Digital Mission) Integration Settings
# Operating Modes: 'sandbox' | 'demo' | 'production'
ABDM_MODE=sandbox
ABDM_BASE_URL=https://dev.abdm.gov.in/api/v1
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_REDIRECT_URI=http://localhost:5000/api/integrations/abdm/callback
ABDM_HFR_ENABLED=true
ABDM_HPR_ENABLED=true
ABDM_ABHA_ENABLED=true
ABDM_CONSENT_ENABLED=true
ABDM_HEALTH_RECORDS_ENABLED=true
ABDM_TIMEOUT_MS=15000

# Multi-Source Data Architecture Mode ('demo' | 'sandbox' | 'production')
DATA_MODE=demo

# Optional External Mapping Integrations
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
