# PFIS Server Environment Variables Template
PORT=5000
NODE_ENV=production

# URLs
CLIENT_URL=https://pfis-patient-friction-intelligence.onrender.com
SERVER_URL=https://pfis-patient-friction-intelligence-system.onrender.com
GOOGLE_CALLBACK_URL=https://pfis-patient-friction-intelligence-system.onrender.com/api/auth/google/callback

# Authentication
JWT_SECRET=your_strong_production_jwt_secret_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Optional: Google Maps API Key
GOOGLE_MAPS_API_KEY=

# Database
DATABASE_TYPE=auto
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ABDM (Ayushman Bharat Digital Mission) Integration Settings
ABDM_MODE=sandbox
ABDM_BASE_URL=https://dev.abdm.gov.in/api/v1
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_REDIRECT_URI=https://pfis-patient-friction-intelligence-system.onrender.com/api/integrations/abdm/callback
ABDM_HFR_ENABLED=true
ABDM_HPR_ENABLED=true
ABDM_ABHA_ENABLED=true
ABDM_CONSENT_ENABLED=true
ABDM_HEALTH_RECORDS_ENABLED=true
ABDM_TIMEOUT_MS=15000

